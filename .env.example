# Match backend PORT — routes are rooted at /auth, /donations, etc. (no /api prefix)
VITE_API_URL=http://localhost:5002

# Must match the backend's IDLE_TIMEOUT_MINUTES exactly — the idle-session
# heartbeat throttle is derived from this value, so a mismatch can make the
# heartbeat fire too infrequently to keep the token alive during active use.
VITE_IDLE_TIMEOUT_MINUTES=
